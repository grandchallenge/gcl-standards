{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/optimality-scorecard-1.0.0.json",
  "title": "Grand Challenge Labs weekly optimality scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "generated_at", "measurement_window", "generator", "metrics", "deviations", "claim_boundaries"],
  "properties": {
    "$schema": {"const": "../schemas/optimality_scorecard.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "pattern": "^GCL-OPT-SCORECARD-[0-9]{4}-W[0-9]{2}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "measurement_window": {"$ref": "#/$defs/window"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow", "run_id", "app_slug"],
      "properties": {
        "repository": {"const": "grandchallenge/.github"},
        "workflow": {"const": ".github/workflows/weekly-optimality-scorecard.yml"},
        "run_id": {"type": "string", "pattern": "^[0-9]+$"},
        "app_slug": {"const": "gcl-council-clerk"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status_contradictions", "unprotected_default_branches", "human_actions_per_governed_decision", "strategic_lanes_in_progress", "active_issues_without_finite_next_obligation", "handoffs_lacking_exact_identities", "median_pr_decision_time_hours", "reproducible_governed_lifecycle", "github_inferred_mathematical_claims"],
      "properties": {
        "status_contradictions": {"$ref": "#/$defs/metric"},
        "unprotected_default_branches": {"$ref": "#/$defs/metric"},
        "human_actions_per_governed_decision": {"$ref": "#/$defs/metric"},
        "strategic_lanes_in_progress": {"$ref": "#/$defs/metric"},
        "active_issues_without_finite_next_obligation": {"$ref": "#/$defs/metric"},
        "handoffs_lacking_exact_identities": {"$ref": "#/$defs/metric"},
        "median_pr_decision_time_hours": {"$ref": "#/$defs/metric"},
        "reproducible_governed_lifecycle": {"$ref": "#/$defs/metric"},
        "github_inferred_mathematical_claims": {"$ref": "#/$defs/metric"}
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "expires_at", "compensating_control", "next_review", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "expires_at": {"type": "string", "format": "date-time"},
          "compensating_control": {"type": "string", "minLength": 1},
          "next_review": {"type": "string", "format": "date-time"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "claim_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_wide_conformance_authorized", "production_claim_authorized", "mathematical_claim_authorized", "certification_claim_authorized", "novelty_claim_authorized", "deployment_claim_authorized", "commercial_claim_authorized"],
      "properties": {
        "organization_wide_conformance_authorized": {"const": false},
        "production_claim_authorized": {"const": false},
        "mathematical_claim_authorized": {"const": false},
        "certification_claim_authorized": {"const": false},
        "novelty_claim_authorized": {"const": false},
        "deployment_claim_authorized": {"const": false},
        "commercial_claim_authorized": {"const": false}
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "sourceHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha"],
      "properties": {
        "repository": {"type": "string", "pattern": "^grandchallenge/[A-Za-z0-9_.-]+$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "value"],
      "properties": {
        "operator": {"enum": ["eq", "lte", "lt", "gte"]},
        "value": {"type": "number"}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "deviation_id"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "deviation_id": {"type": "string", "minLength": 1}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "status", "target", "evidence_references", "measurement_window", "exclusions", "exact_source_heads"],
      "properties": {
        "value": {"type": "number"},
        "unknown": {"$ref": "#/$defs/unknown"},
        "unit": {"type": "string", "minLength": 1},
        "status": {"enum": ["observed", "derived", "unknown", "unverified"]},
        "target": {"$ref": "#/$defs/target"},
        "evidence_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "measurement_window": {"$ref": "#/$defs/window"},
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "exact_source_heads": {"type": "array", "items": {"$ref": "#/$defs/sourceHead"}}
      },
      "oneOf": [
        {
          "required": ["value"],
          "not": {"required": ["unknown"]},
          "properties": {"status": {"enum": ["observed", "derived"]}}
        },
        {
          "required": ["unknown"],
          "not": {"required": ["value"]},
          "properties": {"status": {"enum": ["unknown", "unverified"]}}
        }
      ]
    }
  }
}
