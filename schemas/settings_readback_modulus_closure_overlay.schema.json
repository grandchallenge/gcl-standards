        "required": ["closure_condition", "disposition", "finding", "id", "priority", "remediation_issue", "scope"],
        "type": "object"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "operation_id": {"const": "GCL-GHOS-SETTINGS-READBACK-MODULUS-CLOSURE-OVERLAY-001"},
    "organization_wide_conformance": {"const": false},
    "prior_overlay": {
      "additionalProperties": false,
      "properties": {
        "git_blob_sha1": {"const": "fe0e377a287883c10ce82042a73404acae6a9b2c"},
        "merge_commit": {"const": "692ff6a1b8ec4113c8917470cb0e4c094ff7d334"},
        "path": {"const": "deviations/GCL-GHOS-SETTINGS-READBACK-001.owner-export-overlay.json"},
        "repository": {"const": "grandchallenge/gcl-standards"}
      },
      "required": ["git_blob_sha1", "merge_commit", "path", "repository"],
      "type": "object"
    },
    "replacement_evidence": {"const": "evidence/settings-readback/GCL-GHOS-MODULUS-POST-REPAIR-READBACK-001.reference.json"},
    "status": {"const": "open"}
  },
  "required": ["$schema", "base_campaign_record", "campaign_id", "claim_boundaries", "closed_rows", "effective_condition", "next_gate", "open_priority_counts", "open_rows", "operation_id", "organization_wide_conformance", "prior_overlay", "replacement_evidence", "status"],
  "title": "MODULUS settings-readback closure overlay",
  "type": "object"
}
