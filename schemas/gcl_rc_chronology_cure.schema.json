    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pull_request", "reviewed_head", "merge_commit", "merged_at", "pre_merge_steward_authorization_present"],
      "properties": {
        "repository": {"const": "grandchallenge/gcl-standards"},
        "pull_request": {"const": 15},
        "reviewed_head": {"const": "f1a6ac165f8448dd949f7057c372dfc6cc151734"},
        "merge_commit": {"const": "afea7dd8e952998596fc54e215b6b1e2fcd48645"},
        "merged_at": {"const": "2026-08-02T23:35:59Z"},
        "pre_merge_steward_authorization_present": {"const": false}
