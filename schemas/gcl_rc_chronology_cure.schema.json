{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/gcl-rc-chronology-cure-1.0.0.json",
  "title": "GCL-RC chronology cure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "record_id",
    "state",
    "subject",
    "pre_merge_evidence",
    "post_merge_comments",
    "retrospective_ratification",
    "preserved_boundaries"
  ],
  "properties": {
    "$schema": {"const": "../schemas/gcl_rc_chronology_cure.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "record_id": {"const": "GCL-RC-CHRONOLOGY-CURE-001"},
