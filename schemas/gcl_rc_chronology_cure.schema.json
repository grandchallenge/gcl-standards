    "pre_merge_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_author_approval", "standards_policy_run", "gcl_conformance_run", "artifact_blobs"],
      "properties": {
        "non_author_approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_id", "reviewer", "state", "submitted_at"],
          "properties": {
            "review_id": {"const": 4839993196},
            "reviewer": {"const": "jimsteeg"},
            "state": {"const": "APPROVED"},
            "submitted_at": {"const": "2026-08-02T23:34:55Z"}
          }
        },
        "standards_policy_run": {"const": 30772429041},
        "gcl_conformance_run": {"const": 30772429296},
        "artifact_blobs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["standard", "schema", "template", "adoption_ledger", "decision"],
          "properties": {
            "standard": {"const": "2978dee21e7b7ee942756b39ea49572919cf552d"},
            "schema": {"const": "7bf9ba77df36d1646f123c174b0116c1552bb4cd"},
            "template": {"const": "6d0f041248d520715061bf1af8b1d97e27da0a43"},
            "adoption_ledger": {"const": "926e213f122da621e6472ef5f5fcf9fad214fcd2"},
            "decision": {"const": "3f5eed25efe6a9b593cc07d4125b35955dc9903f"}
          }
        }
      }
    },
    "post_merge_comments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["comment_id", "author", "created_at", "classification"],
        "properties": {
          "comment_id": {"enum": [5160929262, 5160945680]},
          "author": {"enum": ["jimsteeg", "fyremael"]},
          "created_at": {"enum": ["2026-08-02T23:47:40Z", "2026-08-02T23:52:26Z"]},
          "classification": {"const": "post_merge_prospective_wording_not_chronology_cure"}
