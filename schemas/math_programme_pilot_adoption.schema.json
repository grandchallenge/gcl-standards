{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/math-programme-gcl-ghos-pilot-adoption-1.0.0.json",
  "title": "MATH-PROGRAMME GCL-GHOS pilot adoption",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programme",
    "constitutional_source",
    "standard",
    "standard_version",
    "standards_commit",
    "standard_admission",
    "predecessor_adoption",
    "status",
    "admission_gate_status",
    "decision_ref",
    "decision_status",
    "activation_date",
    "pilot_scope",
    "unresolved_deviations",
    "claim_boundaries"
  ],
  "properties": {
    "programme": {"const": "grandchallenge/MATH-PROGRAMME"},
    "constitutional_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "effective_version",
        "amendment",
        "amendment_status",
        "amendment_commit",
        "documentary_closure_commit",
        "review_receipt"
      ],
      "properties": {
        "repository": {"const": "grandchallenge/INTELLECT"},
        "path": {"const": "CONSTITUTION.md"},
        "effective_version": {"const": "1.1.0"},
        "amendment": {"const": "GI-AMEND-0001"},
        "amendment_status": {"const": "effective"},
        "amendment_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "documentary_closure_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "review_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "campaign_id",
            "repository",
            "path",
            "commit_sha",
            "admission_commit",
            "packet_sha256"
          ],
          "properties": {
            "campaign_id": {"const": "GI-AMEND-0001"},
            "repository": {"const": "grandchallenge/INTELLECT"},
            "path": {"type": "string", "pattern": "^governance/reviews/GI-AMEND-0001-[0-9a-f]{12}\\.json$"},
            "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "admission_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "standard": {"const": "GCL-GHOS-00"},
    "standard_version": {"const": "0.1.1"},
    "standards_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "standard_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "operation_id",
        "commit_sha",
        "reviewed_source_commit",
        "decision_git_blob_sha1",
        "standard_git_blob_sha1",
        "packet_sha256",
        "receipt_path"
      ],
      "properties": {
        "repository": {"const": "grandchallenge/gcl-standards"},
        "path": {"const": "admissions/GCL-GHOS-00-0.1.1.json"},
        "operation_id": {"const": "GCL-GHOS-00-0.1.1-ADMISSION-001"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reviewed_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "decision_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "standard_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt_path": {"const": "evidence/coherence-reviews/GCL-STATUS-COHERENCE-001-b39b2f3fab12.json"}
      }
    },
    "predecessor_adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard_version", "standards_commit", "admission_path", "admission_operation_id", "status", "activation_date"],
      "properties": {
        "standard_version": {"const": "0.1.0"},
        "standards_commit": {"const": "31211b286a9c4a2874da5559118ef2f026f7de52"},
        "admission_path": {"const": "admissions/GCL-GHOS-00-0.1.0.json"},
        "admission_operation_id": {"const": "GI-AMEND-0001-STANDARDS-ADMISSION-001"},
        "status": {"const": "active"},
        "activation_date": {"const": "2026-08-03"}
      }
    },
    "status": {"const": "active"},
    "admission_gate_status": {"const": "complete"},
    "decision_ref": {"const": "decisions/ADR-0001_GITHUB_CONSTITUTIONAL_OPERATING_SYSTEM.md"},
    "decision_status": {"const": "accepted"},
    "activation_date": {"const": "2026-08-09"},
    "pilot_scope": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "unresolved_deviations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programme_pilot_adoption_complete",
        "organization_wide_activation_complete",
        "organization_wide_conformance_authorized",
        "mathematical_claim_authorized",
        "certification_claim_authorized",
        "novelty_claim_authorized",
        "deployment_claim_authorized",
        "manufacturing_claim_authorized",
        "commercial_claim_authorized"
      ],
      "properties": {
        "programme_pilot_adoption_complete": {"const": true},
        "organization_wide_activation_complete": {"const": false},
        "organization_wide_conformance_authorized": {"const": false},
        "mathematical_claim_authorized": {"const": false},
        "certification_claim_authorized": {"const": false},
        "novelty_claim_authorized": {"const": false},
        "deployment_claim_authorized": {"const": false},
        "manufacturing_claim_authorized": {"const": false},
        "commercial_claim_authorized": {"const": false}
      }
    }
  }
}
