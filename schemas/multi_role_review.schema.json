{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/multi-role-review-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_class", "effects", "reviewer_system_id", "logical_pass_id", "role", "mode", "subject", "criteria", "finding", "evidence", "unresolved_obligations", "reserved_authority_ref", "authority_claims"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "work_class": {"enum": ["routine_bounded", "substantive", "reserved"]},
    "effects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["routine_maintenance", "public_contract", "authority_boundary", "material_result", "human_authority", "math_certification", "destructive_disposal", "safety_critical", "credential_expansion", "public_commitment", "irreversible_resource", "production_semantic", "corpus_admission"]}},
    "reviewer_system_id": {"type": "string", "minLength": 1},
    "logical_pass_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "mode": {"enum": ["authoring", "non_authoring_read_only"]},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "tree", "base_commit", "dependency_closure_sha256", "material_evidence_sha256"],
      "properties": {
        "repository": {"type": "string", "pattern": "^grandchallenge/[A-Za-z0-9._-]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dependency_closure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "material_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "finding": {"enum": ["approved", "changes_requested", "rejected", "abstained", "not_applicable"]},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unresolved_obligations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reserved_authority_ref": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["reviewer_kind", "reviewer_id", "record_ref", "subject_sha256"], "properties": {
          "reviewer_kind": {"const": "human"}, "reviewer_id": {"type": "string", "minLength": 1},
          "record_ref": {"type": "string", "format": "uri"}, "subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }}
      ]
    },
    "authority_claims": {"type": "object", "additionalProperties": false, "required": ["human_authorized", "mathcert_certified"], "properties": {"human_authorized": {"const": false}, "mathcert_certified": {"const": false}}}
  }
}
