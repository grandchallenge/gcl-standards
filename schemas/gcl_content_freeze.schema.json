{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/gcl_content_freeze.schema.json",
  "title": "GCL Content Freeze",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "campaign",
    "operation",
    "protected_base",
    "artifacts",
    "invalidation",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "record_type": {"const": "GCL_CONTENT_FREEZE"},
    "campaign": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "protected_base": {"type": "string", "minLength": 7},
    "assembled_from_head": {"type": "string", "minLength": 7},
    "hash_semantics": {"type": "string"},
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{40,64}$"
      }
    },
    "invalidation": {
      "type": "object",
      "required": ["governed_artifact_change", "candidate_head_change", "protected_base_drift_before_merge"],
      "additionalProperties": {"type": "string"}
    },
    "authority_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
