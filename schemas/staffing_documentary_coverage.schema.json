{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.dev/schemas/staffing_documentary_coverage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "standard", "standard_version", "audit_method", "repositories", "unresolved_obligations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "standard": {"const": "GCL-AGENT-STAFFING-001"},
    "standard_version": {"const": "1.0.0"},
    "audit_method": {"type": "string", "minLength": 1},
    "repositories": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repository", "audited_commit", "status", "operative_conflicting_language_count", "historical_treatment", "notes"],
        "properties": {
          "repository": {"type": "string", "pattern": "^grandchallenge/.+$"},
          "audited_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "status": {"const": "covered"},
          "operative_conflicting_language_count": {"const": 0},
          "historical_treatment": {"enum": ["none_identified", "retained_as_nonoperative_provenance", "retained_with_prospective_coverage_note"]},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "unresolved_obligations": {"type": "array", "maxItems": 0}
  }
}
